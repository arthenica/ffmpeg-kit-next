{
  "name": "ffmpeg-kit-next-web",
  "version": "9.0.0",
  "description": "FFmpegKitNext bindings for the web (WebAssembly). Native-named FFmpegKit API over a web worker-hosted wasm module",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "lib/",
    "licenses/",
    "LICENSE",
    "SOURCE"
  ],
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "webassembly",
    "wasm",
    "video",
    "audio",
    "transcode"
  ],
  "repository": "https://github.com/arthenica/ffmpeg-kit-next",
  "homepage": "https://github.com/arthenica/ffmpeg-kit-next",
  "author": "ARTHENICA <open-source@arthenica.com> (https://www.arthenica.com)",
  "license": "LGPL-3.0"
}
